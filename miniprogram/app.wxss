/* app.wxss — 全局样式 */

page {
  background: #f5f6f8;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.5;
}

/* ---------- 布局 ---------- */
.row { display: flex; flex-direction: row; align-items: center; }
.row-between { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.row-center { display: flex; align-items: center; justify-content: center; }
.col { display: flex; flex-direction: column; }
.flex-1 { flex: 1; min-width: 0; }

/* ---------- 文字 ---------- */
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ellipsis-2 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.text-sm { font-size: 24rpx; }
.text-gray { color: #999; }
.text-mid { color: #666; }
.text-primary { color: #07c160; }
.text-danger { color: #fa5151; }
.bold { font-weight: 600; }

/* ---------- 价格（涨红跌绿不适用，二手价用醒目色） ---------- */
.price { color: #fa5151; font-weight: 600; }
.price-symbol { font-size: 24rpx; }
.price-num { font-size: 34rpx; }
.price-ori {
  color: #bbb;
  font-size: 24rpx;
  text-decoration: line-through;
  margin-left: 12rpx;
}

/* ---------- 卡片 ---------- */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.card-flat { box-shadow: none; }

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  line-height: 1;
}
.btn::after { border: none; }
.btn-primary { background: #07c160; color: #fff; }
.btn-primary[disabled] { background: #b8e6cb; color: #fff; }
.btn-plain { background: #fff; color: #1a1a1a; border: 1rpx solid #e5e5e5; }
.btn-danger { background: #fff; color: #fa5151; border: 1rpx solid #ffd6d6; }
.btn-block { width: 100%; }

/* ---------- 标签 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  line-height: 1;
  white-space: nowrap;
  /* 徽章不该被挤压变形：无论昵称多长都保持完整 */
  flex-shrink: 0;
  background: #f0f0f0;
  color: #666;
}
.tag-green { background: #e8f7ee; color: #07c160; }
.tag-orange { background: #fff5e6; color: #ff9500; }
.tag-gray { background: #f0f0f0; color: #999; }
.tag-red { background: #ffecec; color: #fa5151; }

/* ---------- 分割线 ---------- */
.divider { height: 1rpx; background: #f0f0f0; }

/* ---------- 空状态 ---------- */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
  color: #bbb;
  font-size: 26rpx;
}
.empty-icon { font-size: 96rpx; margin-bottom: 24rpx; opacity: 0.4; }

/* ---------- 加载 ---------- */
.loading-more {
  text-align: center;
  padding: 32rpx;
  color: #bbb;
  font-size: 24rpx;
}

/* ---------- 表单 ---------- */
.form-item {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.form-item:last-child { border-bottom: none; }
.form-label { width: 160rpx; color: #666; flex-shrink: 0; }
.form-input { flex: 1; font-size: 28rpx; }
.form-placeholder { color: #ccc; }
