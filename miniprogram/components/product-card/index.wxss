.pcard {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.pcard-hover { background: #fafafa; }

.pcard-img-wrap {
  position: relative;
  width: 100%;
  height: 300rpx;
  background: #f5f5f5;
}
.pcard-img { width: 100%; height: 100%; display: block; }

.pcard-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.5);
}
.pcard-badge.tag-green { background: #07c160; }
.pcard-badge.tag-gray { background: rgba(0, 0, 0, 0.5); }
.pcard-badge.tag-red { background: #fa5151; }
/* 跑腿「进行中」用橙色。漏了这条的话它只能吃默认的黑色半透明底，
   和「已完成」完全分不出来。 */
.pcard-badge.tag-orange { background: #ff9500; }

/* 跑腿没有图片时的占位色块 */
.pcard-img-errand {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e8f7ee 0%, #d3f0e0 100%);
}
.pie-icon { font-size: 64rpx; line-height: 1; }
.pie-text { font-size: 22rpx; color: #4aa678; margin-top: 10rpx; }

.pcard-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}
.pcard-mask-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: 2rpx solid #fff;
  border-radius: 50%;
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-12deg);
}

.pcard-body { padding: 20rpx; }

.pcard-title {
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.4;
  min-height: 78rpx;
}

.pcard-place {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}
.pcard-place-icon { font-size: 22rpx; margin-right: 4rpx; }

.pcard-bottom {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 12rpx;
}
.pcard-time { font-size: 22rpx; color: #bbb; }

/* 跑腿：酬劳前缀 + 接单人提示 */
.pcard-reward {
  font-size: 20rpx;
  color: #fff;
  background: #ff9500;
  border-radius: 4rpx;
  padding: 2rpx 8rpx;
  margin-right: 8rpx;
}
.pcard-runner {
  font-size: 22rpx;
  color: #ff9500;
  margin-top: 8rpx;
  overflow: hidden;
}

.pcard-seller {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}
.pcard-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  background: #eee;
}
.pcard-seller-name {
  font-size: 22rpx;
  color: #999;
  max-width: 240rpx;
  /* flex:1 + min-width:0 才能让昵称过长时真的出现省略号（见文件末尾的隔离说明） */
  flex: 1;
  min-width: 0;
}
.pcard-view {
  font-size: 22rpx;
  color: #ccc;
  margin-left: auto;
}

/* ---------------------------------------------------------------
   ⚠️ 下面这组类与 app.wxss 里**故意重复**，别当成冗余删掉。
   自定义组件默认 styleIsolation: isolated —— app.wxss 里的 **class 选择器
   对组件内部不生效**（只有标签名选择器能穿透）。所以卡片上一直在用的
   .ellipsis / .ellipsis-2 / .price / .row 曾经**一条都没生效**，而界面上
   不容易看出来：价格「差不多也是黑的」、标题「差不多就两行」。
   直到 2026-09-18「面交地点改成用户自由输入」，26 字的地点把卡片撑成 3 行、
   价格也不是红色才暴露。结论：组件要用的样式，一律写在本文件里。
   --------------------------------------------------------------- */
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ellipsis-2 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.row { display: flex; flex-direction: row; align-items: center; }

.price { color: #fa5151; font-weight: 600; }
.price-symbol { font-size: 24rpx; }
.price-num { font-size: 34rpx; }
.price-ori {
  color: #bbb;
  font-size: 24rpx;
  text-decoration: line-through;
  margin-left: 12rpx;
}

/* 省略号要出现，flex 子项必须能收缩 —— 少了 min-width:0，长文本宁可把
   卡片撑高也不省略（这正是用户看到「地点占了三行」的直接原因） */
.pcard-place .ellipsis { flex: 1; min-width: 0; }
/* 接单人那行的 text 是 inline，省略号需要 block 才生效（父级已有 overflow:hidden） */
.pcard-runner .ellipsis { display: block; }
