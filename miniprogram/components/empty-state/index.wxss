.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
  color: #bbb;
  font-size: 26rpx;
}
.empty-icon { font-size: 96rpx; margin-bottom: 24rpx; opacity: 0.5; }

.empty-btn {
  margin-top: 40rpx;
  padding: 16rpx 48rpx;
  background: #07c160;
  color: #fff;
  border-radius: 44rpx;
  font-size: 28rpx;
}
