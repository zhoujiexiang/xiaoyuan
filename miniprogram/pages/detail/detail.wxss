.page { padding-bottom: 40rpx; }

/* 轮播 */
.gallery { width: 100%; height: 750rpx; background: #f5f5f5; }
.gallery-img { width: 100%; height: 100%; display: block; }

.status-banner {
  background: rgba(0, 0, 0, 0.7);
  color: #fff;
  text-align: center;
  padding: 16rpx;
  font-size: 26rpx;
  margin: -1rpx 0 0;
}

.sec-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

/* 价格标题 */
.price-big { font-size: 52rpx; }
.title {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.5;
  margin: 20rpx 0;
  color: #1a1a1a;
}
.meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 描述 */
.desc {
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 卖家 */
.seller {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.seller-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #eee;
}
.seller-name { font-size: 30rpx; font-weight: 500; }
.seller-hover { background: #fafafa; }
.seller-arrow {
  font-size: 24rpx;
  color: #bbb;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ---------- 跑腿 ---------- */
/* 没有图片时的顶部占位 */
.gallery-errand {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e8f7ee 0%, #d3f0e0 100%);
}
.ge-icon { font-size: 110rpx; line-height: 1; }
.ge-text { font-size: 26rpx; color: #4aa678; margin-top: 16rpx; }

.reward-label {
  font-size: 22rpx;
  color: #fff;
  background: #ff9500;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  margin-right: 12rpx;
}

.errand-row {
  display: flex;
  align-items: center;
  min-height: 76rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.errand-row:last-child { border-bottom: none; }
.errand-label {
  width: 150rpx;
  flex-shrink: 0;
  color: #999;
  font-size: 26rpx;
}
.errand-val {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1a1a1a;
}

.runner-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #eee;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.runner-name { font-size: 28rpx; color: #1a1a1a; }

.place-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0 0;
}
.place-icon { margin-right: 12rpx; font-size: 28rpx; }
.place-text { font-size: 26rpx; color: #666; }

/* 安全提示 */
.safe-tip {
  display: flex;
  align-items: center;
  margin: 0 24rpx;
  padding: 20rpx 24rpx;
  background: #fff9e6;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #b8860b;
  line-height: 1.5;
}
.safe-icon { margin-right: 10rpx; font-size: 26rpx; }

/* 底部栏 */
.bottom-holder { height: 130rpx; }

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  gap: 16rpx;
  z-index: 10;
}

.bb-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  flex-shrink: 0;
}
.bb-icon-text { font-size: 40rpx; line-height: 1; }
.bb-icon-label { font-size: 20rpx; color: #999; margin-top: 4rpx; }

.bb-btn {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 500;
}
.bb-btn-plain {
  background: #f5f6f8;
  color: #1a1a1a;
}
.bb-btn-primary { background: #07c160; color: #fff; }
.bb-btn-danger { background: #fff; color: #fa5151; border: 1rpx solid #ffd6d6; }
.bb-btn-primary.disabled {
  background: #d9d9d9;
  color: #fff;
}
/* 被平台下架：置灰且不可点 */
.bb-btn-plain.is-blocked {
  background: #f5f5f5;
  color: #bbb;
}

.page-loading {
  padding: 200rpx 0;
  text-align: center;
  color: #bbb;
  font-size: 26rpx;
}
