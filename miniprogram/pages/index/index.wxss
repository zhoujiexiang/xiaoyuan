.page { padding-bottom: 40rpx; }

/* 搜索框 */
.search-bar {
  padding: 20rpx 24rpx;
  background: #fff;
}
.search-input {
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #f5f6f8;
  border-radius: 36rpx;
  padding: 0 28rpx;
}
.search-icon { font-size: 28rpx; margin-right: 12rpx; }
.search-placeholder { color: #bbb; font-size: 28rpx; }

/* 内容类型切换（二手闲置 / 校园跑腿） */
.type-tabs {
  display: flex;
  align-items: center;
  padding: 4rpx 24rpx 20rpx;
  background: #fff;
}
.type-tab {
  position: relative;
  margin-right: 48rpx;
  padding: 8rpx 0;
  font-size: 32rpx;
  color: #999;
}
.type-tab.active {
  color: #1a1a1a;
  font-weight: 600;
}
/* 选中态下划线：用伪元素，避免多一个节点影响自动化的节点选择 */
.type-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 40rpx;
  height: 6rpx;
  margin-left: -20rpx;
  border-radius: 3rpx;
  background: #07c160;
}

/* 提示条 */
.notice {
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  margin: 20rpx 24rpx;
  background: linear-gradient(135deg, #e8f7ee 0%, #d4f0e0 100%);
  border-radius: 16rpx;
}
.notice-text { font-size: 28rpx; font-weight: 600; color: #06804a; }
.notice-sub { font-size: 22rpx; color: #4aa87a; margin-top: 6rpx; }

/* 分类 */
.cate-scroll {
  background: #fff;
  white-space: nowrap;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}
.cate-list { display: flex; padding: 0 24rpx; }
.cate-item {
  flex-shrink: 0;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  background: #f5f6f8;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
}
.cate-item.active {
  background: #07c160;
  color: #fff;
  font-weight: 500;
}

/* 两列瀑布流 */
.grid {
  display: flex;
  padding: 0 24rpx;
  gap: 20rpx;
}
.grid-col { flex: 1; min-width: 0; }
