.page { padding-bottom: 40rpx; }

.tabs {
  display: flex;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 5;
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}
.tab.active { color: #07c160; font-weight: 600; }
.tab-line {
  position: absolute;
  bottom: 8rpx;
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #07c160;
}

.list { padding: 20rpx 24rpx 0; }

.item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.reason {
  font-size: 26rpx;
  color: #fa5151;
  background: #ffecec;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
}
.time { font-size: 22rpx; color: #bbb; }

/* 被举报商品 */
.target {
  display: flex;
  padding: 24rpx 0;
}
.t-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}
.t-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.t-title { font-size: 28rpx; line-height: 1.4; color: #1a1a1a; }
.t-meta { display: flex; align-items: center; gap: 12rpx; }
.t-price { font-size: 30rpx; color: #fa5151; font-weight: 600; }
.t-seller { font-size: 22rpx; color: #999; }

.target-missing {
  padding: 32rpx 0;
  font-size: 24rpx;
  color: #bbb;
  text-align: center;
}

.detail {
  padding: 16rpx 20rpx;
  background: #fafafa;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 8rpx;
}
.d-label { color: #999; }
.d-text { color: #666; }

/* 操作 */
.actions {
  display: flex;
  gap: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}
.act-btn {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 38rpx;
  font-size: 28rpx;
}
.act-ignore {
  background: #f5f6f8;
  color: #666;
}
.act-block {
  background: #fa5151;
  color: #fff;
}
