.page { padding-bottom: 40rpx; }

.tabs {
  display: flex;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 5;
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}
.tab.active { color: #07c160; font-weight: 600; }
.tab-line {
  position: absolute;
  bottom: 8rpx;
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #07c160;
}

.order-list { padding: 20rpx 24rpx 0; }

.order {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.order-no { font-size: 22rpx; color: #bbb; }

/* 商品 */
.order-product {
  display: flex;
  padding: 24rpx 0;
}
.op-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}
.op-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.op-title { font-size: 28rpx; line-height: 1.4; color: #1a1a1a; }
.op-bottom {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.op-time { font-size: 22rpx; color: #bbb; }

/* 对方 */
.order-peer {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 1rpx solid #f5f5f5;
}
.peer-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #eee;
  margin-right: 16rpx;
}
.peer-label { font-size: 24rpx; color: #999; margin-right: 12rpx; }
.peer-name { font-size: 26rpx; color: #333; max-width: 260rpx; }
.peer-chat {
  margin-left: auto;
  padding: 10rpx 24rpx;
  border: 1rpx solid #07c160;
  border-radius: 28rpx;
}
.peer-chat-text { font-size: 24rpx; color: #07c160; }

/* 留言 */
.order-remark {
  padding: 16rpx 20rpx;
  background: #fafafa;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 8rpx;
}
.or-label { color: #999; }
.or-text { color: #666; }

/* 操作 */
.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}
.oa-btn {
  padding: 14rpx 36rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
}
.oa-plain {
  background: #fff;
  color: #666;
  border: 1rpx solid #e5e5e5;
}
.oa-primary {
  background: #07c160;
  color: #fff;
}
