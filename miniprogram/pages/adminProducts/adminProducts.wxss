.page { padding-bottom: 40rpx; }

.search-bar {
  background: #fff;
  padding: 20rpx 24rpx;
}
.search-input {
  height: 72rpx;
  background: #f5f6f8;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}

.tabs {
  display: flex;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 5;
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #666;
  position: relative;
}
.tab.active { color: #07c160; font-weight: 600; }
.tab-line {
  position: absolute;
  bottom: 8rpx;
  width: 40rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #07c160;
}

.list { padding: 20rpx 24rpx 0; }

.item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.item-main { display: flex; }
.img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}
.body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.title { font-size: 28rpx; line-height: 1.4; color: #1a1a1a; }
.meta { display: flex; align-items: center; gap: 12rpx; }
.price { font-size: 30rpx; color: #fa5151; font-weight: 600; }
.seller { font-size: 22rpx; color: #999; }

.actions {
  padding-top: 20rpx;
  margin-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
  display: flex;
  justify-content: flex-end;
}
.act-btn {
  padding: 14rpx 40rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
}
.act-block {
  background: #fff;
  color: #fa5151;
  border: 1rpx solid #ffd6d6;
}
.act-restore {
  background: #07c160;
  color: #fff;
}
