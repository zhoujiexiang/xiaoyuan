.page {
  min-height: 100vh;
  background: #fff;
  padding: 0 60rpx;
  box-sizing: border-box;
}

.logo-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 80rpx;
}
.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(7, 193, 96, 0.25);
}
.app-name { font-size: 44rpx; font-weight: 600; color: #1a1a1a; }
.app-slogan { font-size: 26rpx; color: #999; margin-top: 12rpx; }

/* 学校展示（从 config.js 读取，不可选） */
.school-box {
  display: flex;
  align-items: center;
  height: 96rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 0 28rpx;
  margin-bottom: 40rpx;
}
.sb-label { font-size: 28rpx; color: #999; width: 160rpx; }
.sb-value { flex: 1; font-size: 28rpx; color: #1a1a1a; font-weight: 500; }

/* 登录按钮 */
.login-actions { margin-top: 40rpx; }
.login-btn {
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
}
.skip {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 32rpx 0;
}

/* 协议 */
.agree {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  margin-top: 20rpx;
}
.checkbox {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.checkbox.checked {
  background: #07c160;
  border-color: #07c160;
  color: #fff;
  font-size: 20rpx;
}
.agree-text { font-size: 22rpx; color: #999; line-height: 1.5; }
.agree-link { color: #07c160; }

/* 底部说明 */
.tips { margin-top: 100rpx; padding-bottom: 60rpx; }
.tips-title {
  display: block;
  font-size: 24rpx;
  color: #bbb;
  text-align: center;
  margin-bottom: 24rpx;
}
.tips-list { display: flex; flex-direction: column; align-items: center; }
.tip-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #999;
}
.tip-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #07c160;
  margin-right: 12rpx;
}
