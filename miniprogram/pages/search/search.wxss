.page { padding-bottom: 40rpx; }

.sbar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
}
.sbox {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #f5f6f8;
  border-radius: 36rpx;
  padding: 0 24rpx;
}
.sicon { font-size: 28rpx; margin-right: 12rpx; }
.sinput { flex: 1; font-size: 28rpx; }
.sclear {
  font-size: 24rpx;
  color: #bbb;
  padding: 0 8rpx;
}
.scancel {
  margin-left: 24rpx;
  font-size: 28rpx;
  color: #07c160;
}

/* 闲置 / 跑腿 切换 */
.stype-row {
  display: flex;
  padding: 16rpx 24rpx 4rpx;
  background: #fff;
}
.stype {
  padding: 10rpx 32rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f6f8;
  border-radius: 28rpx;
}
.stype-on {
  color: #fff;
  background: #07c160;
}

.hlist {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}
.hitem {
  padding: 10rpx 24rpx;
  margin: 0 16rpx 16rpx 0;
  background: #f5f6f8;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #666;
}

.result-list {
  display: flex;
  flex-direction: column;
  padding: 20rpx 24rpx 0;
}
