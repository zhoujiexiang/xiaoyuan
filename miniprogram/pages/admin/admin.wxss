.page { padding-bottom: 60rpx; }

.banner {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
}
.banner-title { font-size: 40rpx; font-weight: 600; color: #fff; }
.banner-sub { font-size: 24rpx; color: rgba(255, 255, 255, 0.85); margin-top: 10rpx; }

/* 待办 */
.todo {
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.todo-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}
.todo-item {
  display: flex;
  align-items: center;
  height: 88rpx;
}
.td-icon { font-size: 34rpx; margin-right: 16rpx; }
.td-text { flex: 1; font-size: 28rpx; color: #333; }
.td-count {
  min-width: 40rpx;
  height: 40rpx;
  padding: 0 12rpx;
  border-radius: 20rpx;
  background: #fa5151;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  box-sizing: border-box;
}
.td-arrow { color: #ccc; font-size: 34rpx; }

/* 概览 */
.sec-title { font-size: 28rpx; font-weight: 600; margin-bottom: 24rpx; }
.stat-grid { display: flex; }
.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.sc-num { font-size: 44rpx; font-weight: 600; color: #07c160; line-height: 1.2; }
.sc-label { font-size: 24rpx; color: #999; margin-top: 8rpx; }

/* 菜单 */
.menu { padding: 0 24rpx; }
.menu-item {
  display: flex;
  align-items: center;
  height: 108rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.menu-item:last-child { border-bottom: none; }
.mi-icon { font-size: 36rpx; margin-right: 20rpx; }
.mi-text { flex: 1; font-size: 30rpx; color: #1a1a1a; }
.mi-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  background: #fa5151;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  box-sizing: border-box;
}
.mi-arrow { color: #ccc; font-size: 36rpx; }

.tip {
  margin: 0 24rpx;
  padding: 24rpx;
  background: #f5f9ff;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #6b8fb5;
  line-height: 1.7;
}
.mono {
  font-family: Consolas, Monaco, monospace;
  background: #e8f1fa;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

/* 无权限 */
.no-perm {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 240rpx 60rpx;
}
.np-icon { font-size: 100rpx; opacity: 0.4; margin-bottom: 32rpx; }
.np-text { font-size: 30rpx; color: #666; }
.np-sub { font-size: 24rpx; color: #bbb; margin-top: 12rpx; }
.np-btn { width: 400rpx; margin-top: 60rpx; }
