.page { padding-bottom: 40rpx; }

.tabs {
  display: flex;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 5;
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}
.tab.active { color: #07c160; font-weight: 600; }
.tab-line {
  position: absolute;
  bottom: 8rpx;
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #07c160;
}

.list { padding: 20rpx 24rpx 0; }

.item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.item-head {
  display: flex;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #eee;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.nickname { display: block; font-size: 30rpx; font-weight: 500; }
.time { display: block; font-size: 22rpx; color: #bbb; margin-top: 6rpx; }

.info { padding: 20rpx 0; }
.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.info-row:last-child { margin-bottom: 0; }
.ir-label { width: 140rpx; font-size: 26rpx; color: #999; flex-shrink: 0; }
.ir-value { font-size: 28rpx; color: #1a1a1a; }
.mono {
  font-family: Consolas, Monaco, monospace;
  letter-spacing: 2rpx;
  color: #07c160;
  text-decoration: underline;
}
.copy-hint { font-size: 20rpx; color: #ccc; margin-left: 16rpx; }

/* 操作 */
.actions {
  display: flex;
  gap: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}
.act-btn {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 38rpx;
  font-size: 28rpx;
}
.act-reject {
  background: #fff;
  color: #fa5151;
  border: 1rpx solid #ffd6d6;
}
.act-approve {
  background: #07c160;
  color: #fff;
}

/* 已处理标记 */
.done-mark {
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
  font-size: 26rpx;
  text-align: right;
}
.done-mark.passed { color: #07c160; }
.done-mark.rejected { color: #fa5151; }
